# Env

BIN_VERSION='4.0.0'
ARCHNON_VERSION='4.0.1'
LAST_UPDATE='11/20/2026'
COPYRIGHT='Copyright (c) 2026 Archnon Project. All Rights Reserved.'
CREATOR='@archnon-project (github.com)'
REPO_CLEAR="https://github.com/archnon-project/anon-scripts"
REPO_ONION="(unavailable since $LAST_UPDATE)"

##### colors #####

RED="\e[1;31m"

GREEN="\e[1;32m"

BLUE="\e[1;34m"

P="\e[1;35m"

YELLOW="\e[1;33m"

ORANGE="\e[38;5;214m"

WHITE="\e[1;37m"

LB="\e[36m"

NC="\e[0m"

if ! (command -v ip >/dev/null 2>&1 && command -v macchanger >/dev/null 2>&1); then

  pkgs=(macchanger iproute2)

  if [[ $(command -v apt) ]]; then
    if ! apt install -y ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v pacman) ]]; then
    if ! pacman -Sy --noconfirm --needed --overwrite "*" ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v dnf) ]]; then
    if ! dnf install -y --allowerasing ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v yum) ]]; then
    if ! yum install -y ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v xbps-install) ]]; then
    if ! xbps-install -Sy -f -y "*" ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v zypper) ]]; then
    if ! zypper install ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v apk) ]]; then
    if ! apk add --no-cache ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  elif [[ $(command -v emerge) ]]; then
    if ! emerge -v --oneshot --keep-going ${pkgs[@]}; then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'${pkgs[@]}'${NC}\n"
      exit 1
    fi
  else
    echo -e "\n${RED}[${WHITE}X${RED}] Unsuported package manager, install: ${ORANGE}'${pkgs[@]}'${NC}\n"
    exit 1
  fi
fi

##### Banner #####

echo -e "${YELLOW}                                     "
echo -e "${YELLOW} ▄▄▄▄  ▄▄▄ ▄▄▄▄▄▄ ▄▄ ▄▄ ▄▄▄▄  ▄▄  ▄▄ "
echo -e "${YELLOW}███▄▄ ██▀██  ██   ██ ██ ██▄█▄ ███▄██ "
echo -e "${YELLOW}▄▄██▀ ██▀██  ██   ▀███▀ ██ ██ ██ ▀██ "
echo -e "${YELLOW}                                     "

echo -e "\e[97m[*] Created By: \e[95m$CREATOR\e[97m\e[0m"

version(){
echo -e "
\e[97m[   \e[92mArchnon Project   \e[97m]\e[95m => \e[97mVersion: \e[94m$ARCHNON_VERSION (\e[93m$LAST_UPDATE\e[94m)\e[0
	 
\e[96mCurrent Binary: \e[92m$0\e[0m
\e[96mCurrent Binary Version: \e[92m$BIN_VERSION\e[0m

\e[97m[\e[92m   Copyright\e[97m   ]

\e[96mCopyright: \e[92m$COPYRIGHT\e[0m
\e[96mCreator: \e[92m$CREATOR\e[0m

\e[97m[   \e[92mGit Repositories\e[97m   ]

\e[96mRepo Clearnet: \e[92m$REPO_CLEAR\e[0m
\e[96mRepo Onion: \e[92m$REPO_ONION\e[0m\n"
exit $?
}

usage() {
  echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${P}saturn ${NC}<${GREEN}COMMAND${NC}> ${NC}<${GREEN}OPTIONS${NC}>${NC}"
  echo -e "\n${BLUE}[${ORANGE}1${BLUE}] ${LB}--change-mac ${NC}<${P}interface${NC}>: ${WHITE}Change MAC of interface.${NC}"
  echo -e "\n${BLUE}[${ORANGE}2${BLUE}] ${LB}--enable: ${WHITE}Allow change MAC of interface on boot${NC}"
  echo -e "\n${BLUE}[${ORANGE}3${BLUE}] ${LB}--disable: ${WHITE}Disable ${GREEN}change MAC of interface on boot${NC}"
  echo -e "\n${BLUE}[${ORANGE}4${BLUE}] ${LB}--bg-change ${NC}<${P}interface${NC}>: ${WHITE}Change MAC of interface in background.${NC}"
  echo -e "\n${BLUE}[${ORANGE}5${BLUE}] ${LB}--restore-mac: ${WHITE}Restore MAC of interface.${NC}"
  echo -e "\n${BLUE}[${ORANGE}6${BLUE}] ${LB}--list-ifaces: ${WHITE}List available interfaces.${NC}"

  echo -e "\n${BLUE}[${ORANGE}7${BLUE}] ${LB}--version: ${WHITE}Print version of binary${NC}"
  echo -e "\n${BLUE}[${ORANGE}7${BLUE}] ${LB}--help: ${WHITE}Print manual${NC}\n"
}

change() {
  ip link set $device down >/dev/null 2>&1

  macchanger -r -b $device >/dev/null 2>&1

  ip link set $device up >/dev/null 2>&1
}

restore() {
  ip link set $device down >/dev/null 2>&1

  macchanger -p $device >/dev/null 2>&1

  ip link set $device up >/dev/null 2>&1
}

createsv() {

  label=saturn

  if [ ! -f /etc/systemd/system/$label.service ] && command -v systemctl >/dev/null 2>&1; then
    touch /etc/systemd/system/$label.service

    echo -e "\n[Unit]\nDescription=MAC change for $device\n[Service]\nType=forking\nExecStart=/usr/local/bin/$label --change-mac $device\nRemainAfterExit=yes\nUser=root\n[Install]\nWantedBy=multi-user.target\n" >>/etc/systemd/system/$label.service

  fi

  if [ ! -f /etc/sv/$label/run ] && command -v runit >/dev/null 2>&1; then
    mkdir -p /etc/sv/$label/
    touch /etc/sv/$label/run

    echo -e "#!/bin/sh\nexec /usr/local/bin/$label --change-mac $device\n" >>/etc/sv/$label/run
    chmod +x /etc/sv/$label/run
  fi

  if [ ! -f /etc/init.d/$label ] && command -v rc-service >/dev/null 2>&1; then
    touch /etc/init.d/$label

    echo "#!/sbin/openrc-run\nname=$label\ncommand="/usr/local/bin/$label"\ncommand_args="--change-mac $device"\ncommand_background=true\npidfile="/run/${RC_SVCNAME}.pid"\ndepend() {\n    need net\n}\n" >>/etc/init.d/$label

    chmod +x /etc/init.d/$label >/dev/null 2>&1
  fi
}
createsv

enable() {

  label=saturn

  if ! (command -v systemctl >/dev/null 2>&1 || command -v sv >/dev/null 2>&1 || command rc-service >/dev/null 2>&1); then
echo -e "\n\e[91m[x] Error: unsupported service manager, script only runs on:\e[0m
\n\e[97m1. \e[92msystemd.\e[0m
\e[97m2. \e[92mrunit.\e[0m
\e[97m3. \e[92mopen-rc.\e[0m\n"
    exit 1
  fi

  if [ -f /etc/systemd/system/$label.service ] && command -v systemctl >/dev/null 2>&1; then

    if systemctl is-enabled $label >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Enabled service for '$device'${NC}\n"
      exit 0
    else
      systemctl enable $label >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program will run on boot for '$device'${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't enable service (unknown)${NC}\n"
    fi
  fi

  if [ -f /etc/sv/$label/run ] && command -v runit >/dev/null 2>&1; then

    if [ -d /run/runit/service ]; then
      RSDIR=/run/runit/service
    elif [ -d /etc/service ]; then
      RSDIR=/etc/service
    elif [ -d /var/run/service ]; then
      RSDIR=/var/run/service
    fi

    if ls -l $RSDIR/$label/ >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Enabled service for '$device'${NC}"
      exit 0
    else
      ln -s /etc/sv/$label $RSDIR >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program will run on boot for '$device'${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't enable service (unknown)${NC}\n"
    fi
  fi

  if [ -f /etc/init.d/$label ] && command -v rc-update >/dev/null 2>&1; then

    if rc-update | grep -IE "$label" >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Enabled service for '$device'${NC}\n"
      exit 0
    else
      rc-update add $label default >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program will run on boot for '$device'${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't enable service (unknown)${NC}\n"
    fi
  fi
}

disable() {

  label=saturn

  if ! (command -v systemctl >/dev/null 2>&1 || command -v sv >/dev/null 2>&1 || command rc-service >/dev/null 2>&1); then
echo -e "\n\e[91m[x] Error: unsupported service manager, script only runs on:\e[0m
\n\e[97m1. \e[92msystemd.\e[0m
\e[97m2. \e[92mrunit.\e[0m
\e[97m3. \e[92mopen-rc.\e[0m\n"
      exit 1
  fi

  if [ -f /etc/systemd/system/$label.service ] && command -v systemctl >/dev/null 2>&1; then

    if ! systemctl is-enabled $label >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n"
      exit 0
    else
      systemctl disable $label >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't disable service (unknown)${NC}\n"
      chattr -i /etc/systemd/system/$label.service >/dev/null 2>&1
      rm -rf /etc/systemd/system/$label.service >/dev/null 2>&1
      exit 0
    fi
  fi

  if [ -f /etc/sv/$label/run ] && command -v runit >/dev/null 2>&1; then

    if [ -d /run/runit/service ]; then
      RSDIR=/run/runit/service

    elif [ -d /etc/service ]; then
      RSDIR=/etc/service

    elif [ -d /var/run/service ]; then
      RSDIR=/var/run/service
    fi

    if ! ls -l $RSDIR/$label/ >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n"
      exit 0
    else
      rm -rf $RSDIR/$label >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't disable service (unknown)${NC}\n"
      exit 0
    fi
  fi

  if [ -f /etc/init.d/$label ] && command -v rc-service >/dev/null 2>&1; then

    if ! rc-update | grep -IE "$label" >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n"
      exit 0
    else
      rc-update del $label default >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Program wont run on boot${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't disable service (unknown)${NC}\n"
      chattr -i /etc/init.d/$label >/dev/null 2>&1
      rm -rf /etc/init.d/$label >/dev/null 2>&1
      exit 0
    fi
  fi
}

dlist() {
  if pgrep -x mars >/dev/null 2>&1; then
    echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Active background changes: ${NC}"
    pgrep -a mars
    echo -e "\n"
  fi
}

while [ $# -gt 0 ]; do
  case $1 in

  --change-mac)
    mode=1
    device=$2

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if [ -z $device ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Error: need an interface.${NC}\n"
      exit 1
    fi

    if ! macchanger -s "$device" >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such interface: ${ORANGE}'$device'${NC}\n"
      exit 1
    fi

    change && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} $(macchanger -s $device | grep Current)${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: MAC not changed${NC}\n"
    exit 1

    shift 2
    break

    ;;

  --enable)
    mode=2
    device=$2

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if [ -z $device ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Error: need an interface.${NC}\n"
      exit 1
    fi

    if ! macchanger -s $device >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such interface: ${ORANGE}'$device'${NC}\n"
      exit 1
    fi

    enable

    exit 0

    shift 2
    break

    ;;

  --disable)
    mode=3

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    disable

    exit 0

    shift 1
    break

    ;;

  --bg-change)
    mode=4
    dev=$2
    sec=$3

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if [[ -z "$dev" || -z "$sec" ]]; then
      echo -e "\n${RED}[${WHITE}X${RED}] usage: saturn --bg-change ${NC}<${P}interface> <seconds>${NC}\n"
      exit 1
    fi

    if ! macchanger -s $device >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such interface: ${ORANGE}'$device'${NC}\n"
      exit 1
    fi

    if ! command -v mars >>/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] Missing background script: ${ORANGE}'mars'${NC}\n"
      exit 1
    else
      mars $device $sec && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Changing MAC as a bg PID${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Couldn't launch background pid${NC}\n"
      dlist
      exit 0
    fi

    shift 3
    break

    ;;

  --restore-mac)
    mode=5
    device=$2

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if [ -z $device ]; then
      usage
      echo -e "\n${RED}[${WHITE}X${RED}] Error: need an interface.${NC}\n"
      exit 1
    fi

    if ! macchanger -s "$device" >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such interface: ${ORANGE}'$device'${NC}\n"
      exit 1
    fi

    restore && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} $(macchanger -s $device | grep Current)${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't restore MAC${NC}\n"
    exit 0

    shift 2
    break

    ;;

  --list-ifaces)
    mode=6

    if ! ip link >/dev/null 2>&1; then
      echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't show interfaces.${NC}\n"
      exit 1
    else
      echo -n -e "\n"
      ip link
      exit 0
    fi

    shift 1
    break

    ;;

  --help)
    mode=6
    usage
    exit 1

    shift 1
    break

    ;;

  --version)
    mode=7
    version
    exit $?
    shift 1
    break

    ;;

  --* | -* | *)
    mode=8

    usage
    exit 1

    shift 1
    break

    ;;

  esac
done

if [ -z $mode ]; then
  usage
  exit 1
fi
