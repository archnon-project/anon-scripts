##### Colors #####

RED="\e[1;31m"

GREEN="\e[1;32m"

BLUE="\e[1;34m"

P="\e[1;35m"

YELLOW="\e[1;33m"

ORANGE="\e[38;5;214m"

WHITE="\e[1;37m"

LB="\e[36m"

NC="\e[0m"


BIN_VERSION='4.0.0'
COPYRIGHT='Copyright (c) 2026 Archnon Project. All Rights Reserved.'
CREATOR='@archnon-project (github.com)'
REPO_CLEAR="https://github.com/archnon-project/anon-scripts"
ARCHNON_VERSION='4.0.1'
LAST_UPDATE="11/20/2026"
REPO_ONION="(unavailable since $LAST_UPDATE)"

version(){
echo -e "
\e[97m[   \e[92mArchnon Project   \e[97m] \e[95m=>\e[97m Version: \e[93m$ARCHNON_VERSION \e[94m(\e[96m$LAST_UPDATE\e[94m)\e[0m

\e[96mCurrent Binary: \e[92m$0\e[0m

\e[96mCurrent Binary Version: \e[92m$BIN_VERSION\e[0m

\e[97m[   \e[92mCopyright   \e[97m]\e[0m

\e[96mCopyright: \e[92m$COPYRIGHT\e[0m
\e[96mProject Creator: \e[92m$CREATOR\e[0m

\e[97m[\e[92m   Git Repositories   \e[97m]\e[0m

\e[96mClearnet: \e[92m$REPO_CLEAR\e[0m
\e[96mDarknet (Tor): \e[92m$REPO_ONION\e[0m\n"
exit $?
}

##### Default Socks5 Address #####
ADDR=127.0.0.1
PORT=9150

ADDR1=127.0.0.1
PORT1=4447

# Env

VERBOSE="no"
PROXY_MODE="tor"

usage() {
  echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${P}neptune ${NC}<${GREEN}COMMAND${NC}> <${LB}URL${NC}>${NC}"
  echo -e "\n${BLUE}[${YELLOW}1${BLUE}]${ORANGE} --url ${NC}<${P}url${NC}>: ${WHITE}Resolv url using default proxy addr: '$ADDR:$PORT'.${NC}"
  
  echo -e "\n${BLUE}[${YELLOW}2${BLUE}]${ORANGE} --set-dns ${NC}<${P}addr${NC}>: ${WHITE}Change universal dns address for an specific addr.${NC}"

  echo -e "\n${BLUE}[${YELLOW}3${BLUE}]${ORANGE} --help: ${WHITE}Print manual & exit.${NC}"
  echo -e "\n${BLUE}[${YELLOW}4${BLUE}]${ORANGE} --version: ${WHITE}Print program info & exit.${NC}"

  echo -ne "\n"

exit $?
}

need=(e2fsprogs curl)

if ! $(command -v curl >/dev/null 2>&1 && command -v chattr >/dev/null 2>&1); then
  if [[ $(command -v apt) ]]; then
    if ! apt install -y "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v pacman) ]]; then
    if ! pacman -Sy --noconfirm --needed --overwrite "*" "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v dnf) ]]; then
    if ! dnf install -y --allowerasing "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v yum) ]]; then
    if ! yum install -y "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v xbps-install) ]]; then
    if ! xbps-install -Sy -f -y "*" "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v zypper) ]]; then
    if ! zypper install "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v apk) ]]; then
    if ! apk add --no-cache "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  elif [[ $(command -v emerge) ]]; then
    if ! emerge -v --oneshot --keep-going "${need[@]}"; then
      echo -e "\n${RED}[${WHITE}X${RED}] Could not install: ${ORANGE}"${need[@]}"${NC}\n"
      exit 1
    fi
  else
    echo -e "\n${RED}[${WHITE}X${RED}] Unsuported package manager, install: ${ORANGE}'"${need[@]}"'${NC}\n"
    exit 1
  fi
fi

echo -e "${BLUE}                                            "
echo -e "${BLUE}▄▄  ▄▄ ▄▄▄▄▄ ▄▄▄▄ ▄▄▄▄▄▄ ▄▄ ▄▄ ▄▄  ▄▄ ▄▄▄▄▄ "
echo -e "${BLUE}███▄██ ██▄▄  ██▄█▀  ██   ██ ██ ███▄██ ██▄▄  "
echo -e "${BLUE}██ ▀██ ██▄▄▄ ██     ██   ▀███▀ ██ ▀██ ██▄▄▄ "
echo -e "${BLUE}                                            "
echo -e "\n\e[97m[*] Created By: \e[95m$CREATOR\e[95m\e[0m"


if [[ $# -gt 0 ]]; then
while [ $# -gt 0 ]; do
  case $1 in
  --url)
    url=$2

	if ! pgrep -xa tor >/dev/null 2>&1 && ! pgrep -a i2pd >/dev/null 2>&1; then
		echo -e "\n\e[91m[\e[97m-\e[91m] No active proxy found on this system, please start tor/i2pd.\e[0m\n"
        exit 1
    fi

    if [ -z $url ]; then
	  
      echo -e "\n${RED}[${WHITE}X${RED}] Error: need an url${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${LB}neptune ${P}--url ${YELLOW}<${NC}url${YELLOW}>${NC}\n"
	  exit 1

    else

      PROXY_MODE=$PROXY_MODE

      [[ $PROXY_MODE == "tor" ]] && DEF_ADDR="$ADDR:$PORT"
	
      [[ $PROXY_MODE == "i2pd" ]] && DEF_ADDR="$ADDR1:$PORT1"

      SOCKS5="$DEF_ADDR"

      echo -e "\n\e[94m[\e[93m!\e[94m]\e[92m Resolve: \e[93m'$url'\e[92m status ...\e[0m"

      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Proxy Address: \e[93m$SOCKS5${NC}"

      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Proxy Mode: \e[93m$PROXY_MODE${NC}"

      sleep 1

      cmd="curl --socks5-hostname $SOCKS5 --url $url -s"

      echo -e "\n\e[96moutput ==>\e[0m $($cmd)\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't resolv ${ORANGE}'$url'${NC}\n"
      
      sleep 1

    fi

    shift 2
 
    ;;

  --set-dns)
    addr=$2

    if ! [ -f /etc/resolv.conf ]; then
      	  touch /etc/resolv.conf >/dev/null 2>&1
    fi

    if [ -z $addr ]; then
      
      echo -e "\n${RED}[${WHITE}X${RED}] Error: need an IP address, like '$ADDR' which is default on this script.${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${LB}neptune ${BLUE}--set-dns ${YELLOW}<${BLUE}addr${YELLOW}>${NC}\n"
      exit 1

    else

      chattr -i /etc/resolv.conf >/dev/null 2>&1
      rm /etc/resolv.conf >/dev/null 2>&1
      touch /etc/resolv.conf >/dev/null 2>&1

      echo "nameserver $addr" | tee /etc/resolv.conf >/dev/null 2>&1 && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} New dns address: ${GREEN}$addr${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Error: couldn't set address, run as sudo/root${NC}\n"

      sleep 1

    fi

    shift 2

    ;;
    
    --version)
    version

    sleep 1

    shift 1

    ;;

  --help)
 
    usage

    shift 1

    ;;

  --* | -* | *)

	if pgrep -xa tor >/dev/null 2>&1 && pgrep -a i2pd >/dev/null 2>&1; then
		echo -e "\n\e[96moutput ==> \e[0m$(curl --socks5-hostname "$ADDR:$PORT" --url $1 -s)\n"
	else
        echo -e "\n\e[91m[\e[97m-\e[91m] No active proxy found on this system, please start tor/i2pd.\e[0m\n"
        exit 1
    fi

    echo -e "\n\e[96moutput ==> \e[0m$(curl --socks5-hostname "$ADDR:$PORT" --url $1 -s)\n"

	sleep 1

    exit $?

    shift 1

    ;;

  esac
done

else
	usage
fi
