# Env
BIN_VERSION='4.0.0'
ARCHNON_VERSION='4.0.1'
LAST_UPDATE='11/20/2026'
COPYRIGHT='Copyright (c) 2026 Archnon Project. All Rights Reserved.'
CREATOR='@archnon-project (github.com)'
REPO_CLEAR="https://github.com/archnon-project/anon-scripts"
REPO_ONION="(unavailable since $LAST_UPDATE)"
REPO_DIR="anon-scripts"

# Colors

RED="\e[1;31m"

GREEN="\e[1;32m"

BLUE="\e[1;34m"

P="\e[1;35m"

WHITE="\e[1;37m"

YELLOW="\e[1;33m"

ORANGE="\e[38;5;214m"

LB="\e[36m"

NC="\e[0m"

##### Dependencies && package managers ######

pkgs=(e2fsprogs)

if ! (command -v chattr >/dev/null 2>&1); then
  if [[ $(command -v apt) ]]; then
    if ! apt install -y ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v pacman) ]]; then
    if ! pacman -Sy --noconfirm --needed --overwrite "*" ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v dnf) ]]; then
    if ! dnf install -y --allowerasing ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v yum) ]]; then
    if ! yum install -y ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v xbps-install) ]]; then
    if ! xbps-install -Sy -f -y "*" ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v zypper) ]]; then
    if ! zypper install ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v apk) ]]; then
    if ! apk add --no-cache figlet; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  elif [[ $(command -v emerge) ]]; then
    if ! emerge -v --oneshot --keep-going ${pkgs[@]}; then
      echo -e "\n${RED}[${NC}-${RED}] Could not install: ${ORANGE}${pkgs[@]}${NC}"
      exit 1
    fi
  else
    echo -e "\n${RED}[${NC}-${RED}] Unsuported package manager, install: ${ORANGE}'${pkgs[@]}'${NC}"
    exit 1
  fi
fi

##### Banner #####

echo -e "${LB}                                     "
echo -e "${LB}▄▄ ▄▄ ▄▄▄▄   ▄▄▄  ▄▄  ▄▄ ▄▄ ▄▄  ▄▄▄▄ "
echo -e "${LB}██ ██ ██▄█▄ ██▀██ ███▄██ ██ ██ ███▄▄ "
echo -e "${LB}▀███▀ ██ ██ ██▀██ ██ ▀██ ▀███▀ ▄▄██▀ "
echo -e "${LB}                                     "
echo -e "\e[97m[*] Created By: \e[95m$CREATOR\e[0m"

# Bind Addr
# Default 127.0.0.1(loopback/lo/localhost)

ADDR=127.0.0.1

# Tor Ports
# Default order: 6969, 5353, 9150, 9151, 8181

TRANS=6969
TDNS=5353
SOCKS=9150
CONTROL=9151
HTTP=8181

# Configuration Files
# Default: /etc/tor/torrc, /etc/archnon.nft, /etc/resolv.conf

TORRC=/etc/tor/torrc
FWFILE=/etc/archnon.nft
DNS=/etc/resolv.conf

version(){
echo -e "
\e[97m[   \e[92mArchnon Project   \e[97m]\e[95m => \e[97mVersion: \e[93m$ARCHNON_VERSION \e[94m(\e[96m$LAST_UPDATE\e[94m)\e[0
	 
\e[96mCurrent Binary: \e[92m$0\e[0m
\e[96mCurrent Binary Version: \e[92m$BIN_VERSION\e[0m

\e[97m[\e[92m   Copyright\e[97m   ]

\e[96mCopyright: \e[92m$COPYRIGHT\e[0m
\e[96mCreator: \e[92m$CREATOR\e[0m

\e[97m[   \e[92mGit Repositories\e[97m   ]

\e[96mRepo Clearnet: \e[92m$REPO_CLEAR\e[0m
\e[96mRepo Onion: \e[92m$REPO_ONION\e[0m\n"
exit $?
}

usage() {
  echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${P}$0 ${NC}<${GREEN}COMMAND${NC}> <${P}OPTIONS${NC}>${NC}"
  echo -e "\n${BLUE}[${ORANGE}1${BLUE}]${LB} --reset-torrc${BLUE}: ${ORANGE}Apply default template for torrc.${NC}"
  echo -e "\n${BLUE}[${ORANGE}2${BLUE}]${LB} --print-file${BLUE} ${NC}<${P}file${NC}>: ${ORANGE}Print the content of some file.${NC}"
  echo -e "\n${BLUE}[${ORANGE}4${BLUE}]${LB} --custom-torrc${BLUE} ${NC}<${P}torrc${NC}>: ${ORANGE}Load ${P}custom Torrc.${NC}"
  echo -e "\n${BLUE}[${ORANGE}5${BLUE}]${LB} --bridges-torrc${BLUE} ${NC}<${P}torrc${NC}> ${NC}<${P}bridge_kind${NC}> ${NC}<${P}binary${NC}>: ${ORANGE}Load ${P}Custom Bridges for Torrc.${NC}"
  echo -e "\n${BLUE}[${ORANGE}6${BLUE}]${LB} --update-project${BLUE}: ${ORANGE}update ${P}Archnon Project ${ORANGE}via git.${NC}"

  echo -e "\n${BLUE}[${ORANGE}7${BLUE}]${LB} --version${BLUE}: ${ORANGE}Print version of binary.${NC}"
  echo -e "\n${BLUE}[${ORANGE}8${BLUE}]${LB} --help${BLUE}: ${ORANGE}Print manual.${NC}\n"
}

# modes "$1"

while [ $# -gt 0 ]; do
  case $1 in

  --reset-torrc)
    mode=10

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if ! [ -f $TORRC ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] There's no torrc to reset${NC}\n"
      exit 1
    fi

    chattr -i $TORRC >/dev/null 2>&1
    rm $TORRC >/dev/null 2>&1

    touch $TORRC >/dev/null 2>&1

    rtorc() {
      cat <<EOT >$TORRC
# <--- By uranus for Torrc ---> #
# File locked by chattr +i, unlock: chattr -i $TORRC
		
CookieAuthentication 0
VirtualAddrNetworkIPv4 10.192.0.0/10
AutomapHostsOnResolve 1
AutomapHostsSuffixes .exit,.onion
TransPort $ADDR:$TRANS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
DNSPort $ADDR:$TDNS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
SocksPort $ADDR:$SOCKS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr
ControlPort $ADDR:$CONTROL
HTTPTunnelPort $ADDR:$HTTP
EntryNodes {is},{ch},{fi},{ro}
ExitNodes {is},{ch},{fi},{ro}
StrictNodes 1
MaxCircuitDirtiness 10
ClientUseIPv6 0
ClientPreferIPv6ORPORT 0
ClientRejectInternalAddresses 1
AvoidDiskWrites 1
EnforceDistinctSubnets 1
HardwareAccel 1
EOT
    }

    rtorc && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Done, restart Tor to apply${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Could not reset: ${ORANGE}$TORRC${NC}\n"
    exit 0

    shift 1

    ;;

  --custom-torrc)
    mode=11

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    file=$2

    if [ -z $file ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Missing a file${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${LB}uranus ${BLUE}--custom-torrc ${YELLOW}<${NC}torrc${YELLOW}>${NC}"
      exit 1
    fi

    if ! [ -f $file ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such file: ${ORANGE}'$2'${NC}\n"
      exit 1
    fi

    if [ -f $TORRC ]; then
      chattr -i $TORRC >/dev/null 2>&1
      rm $TORRC >/dev/null 2>&1
      touch $TORRC >/dev/null 2>&1
      echo -e "\n# NOT TOUCH, THIS FILE IS CUSTOM LOAD #" >>$TORRC

      # Sorry but changing Tor ports without touching script may break the firewall logic #

      echo -e "\n# Do NOT change Tor ports, it may break script's firewall logic !! #\nTransPort $ADDR:$TRANS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr\nDNSPort $ADDR:$DNS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr\nSocksPort $ADDR:$SOCKS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr\nControlPort $ADDR:$CONTROL\nHTTPTunnelPort $ADDR:$HTTP" >>$TORRC
      cat "$file" >>$TORRC && echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Custom Torrc applied${NC}\n" || echo -e "\n${RED}[${WHITE}X${RED}] Could not apply: ${ORANGE}'$file'${NC}\n"
      chattr +i $TORRC >/dev/null 2>&1

      if id debian-tor >/dev/null 2>&1; then
        export TOR_USER="debian-tor"
      elif id tor >/dev/null 2>&1; then
        export TOR_USER="tor"
      elif id toranon >/dev/null 2>&1; then
        export TOR_USER="toranon"
      else
        echo -e "\n${RED}[${WHITE}X${RED}] No user for tor?${NC}\n"
        read -e -p $'\n\e[1;31m[\e[1;33mwarn\e[1;31m]\e[1;37m Please, enter a system user(but not root) => \e[1;32m' TOR_USER $TOR_USER

        if id $TOR_USER >/dev/null 2>&1; then
          export TOR_USER=$TOR_USER
        else
          echo -e "\n${RED}[${LB}err${RED}] There is no user: ${ORANGE}'$TOR_USER'${NC}\n"
          exit 1
        fi

      fi

      chown -R $TOR_USER:$TOR_USER $TORRC >/dev/null 2>&1

      if tor --verify-config >/dev/null 2>&1; then
        echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Valid Torrc, you can restart Tor${NC}\n"
        exit 0
      else
        echo -e "\n${RED}[${WHITE}X${RED}] Invalid Torrc${NC}\n"
        exit 1
      fi

    else
      echo -e "\n${RED}[${WHITE}X${RED}] No such file: ${ORANGE}'$TORRC'${NC}\n"
      exit 1
    fi

    shift 2

    ;;

  --print-file)

    mode=12
    object=$2

    if [[ -z $object ]]; then
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${LB}uranus ${P}--print-file ${NC}<${BLUE}file${NC}>"
      echo -e "\n${ORANGE}[${YELLOW}warn${ORANGE}]${NC} Files are:"
      echo -e "\n\e[97m1. ${LB}firewall${NC}: ${BLUE}(${GREEN}$FWFILE${BLUE})${NC}"
      echo -e "\n\e[97m2. ${LB}torrc${NC}: ${BLUE}(${GREEN}$TORRC${BLUE})${NC}"
      echo -e "\n\e[97m3. ${LB}dns${NC}: ${BLUE}(${GREEN}$DNS${BLUE})${NC}\n"
      exit 1
    fi

    if [ "$object" == "firewall" ]; then

      if ! [ -f $FWFILE ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] There's no firewall file to show${NC}\n"
        exit 1
      else
        echo -ne "\n"
        echo -ne "\e[95moutput \e[97m=>\e[93m $(cat $FWFILE)\e[93m"
        echo -e "\n"
        exit $?
      fi

    elif [ "$object" == "torrc" ]; then

      if ! [ -f $TORRC ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] There's no Torrc to show${NC}\n"
        exit 1
      else
        echo -ne "\n"
        echo -ne "\e[95moutput \e[97m=>\e[93m $(cat $TORRC)\e[93m"
        echo -e "\n"
        exit $?
      fi

    elif [ "$object" == "dns" ]; then

      if ! [ -f $DNS ]; then
        echo -e "\n${RED}[${WHITE}X${RED}] There's no dns file show${NC}\n"
        exit 1
      else
        echo -ne "\n"
        echo -ne "\e[95moutput \e[97m=>\e[93m $(cat $DNS)\e[93m"
        echo -e "\n"
        exit $?
      fi
    else
      echo -e "\n${RED}[${WHITE}X${RED}] Error: Invalid file '${ORANGE}$object'${NC}\n"
      exit 1
    fi

    shift 2

    ;;

  --bridges-torrc)
    mode=7

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    if ! [ -f $TORRC ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Error: file doesn't even exists \e[93m'$TORRC'${NC}\n"
      exit 1
    fi

    file=$2
    kind=$3
    bin=$4

    chattr -i $TORRC >/dev/null 2>&1
    rm $TORRC >/dev/null 2>&1
    touch $TORRC >/dev/null 2>&1

    if [[ -z "$file" || -z $bin || -z $kind ]]; then
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} usage: ${LB}uranus ${BLUE}--bridges-torrc ${YELLOW}<${NC}torrc${YELLOW}> ${YELLOW}<${NC}kind${YELLOW}> ${YELLOW}<${NC}bin${YELLOW}>${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} example: ${LB}uranus ${BLUE}--bridges-torrc ${P}bridges.txt ${P}obfs4 ${P}/usr/bin/obfs4proxy${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} correct format for bridges: ${NC}<${YELLOW}'bridge'${NC}> ${YELLOW}<${NC}type${YELLOW}> [${NC}IP${YELLOW}]${GREEN}:${YELLOW}[${NC}PORT${YELLOW}] [${NC}fingerprint${YELLOW}] [${NC}Key=value${YELLOW}]${NC}"
      echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} example bridge: ${GREEN}bridge obfs4 212.227.255.73:8443 F54793EA577F90F679A9C0E787AB8431BDDABB41 cert=dOzgPNKdfo3SZIC2Sp3qtDX7wuo1KLzBe1KSzSAuK9CkySqF5/TnudjgHPub5sobpso4fw iat-mode=0${NC}\n"
      exit 1

    elif ! [[ -f $file || -f $bin ]]; then
      echo -e "\n${RED}[${WHITE}X${RED}] No such bin or file${NC}\n"
      exit 1
    fi

    bridges=$(cat "$file")

    echo -e "\n# <--- Generated by uranus ---> #\n# Bridges Configuration #\n# NOT TOUCH, THIS FILE IS CUSTOM LOAD #\n# File locked by chattr +i, unlock: sudo chattr -i $TORRC #\nCookieAuthentication 0\nVirtualAddrNetworkIPv4 10.192.0.0/10\nAutomapHostsOnResolve 1\nMaxCircuitDirtiness 60\nAutomapHostsSuffixes .exit,.onion\nTransPort $ADDR:$TRANS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr\nDNSPort $ADDR:$DNS\nControlPort $ADDR:$CONTROL\nSocksPort $ADDR:$SOCKS IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestPort IsolateDestAddr\nHTTPTunnelPort $ADDR:$HTTP\nClientTransportPlugin $kind exec $bin\n$bridges\nUseBridges 1\nClientUseIPv6 0\nClientPreferIPv6ORPORT 0\nClientRejectInternalAddresses 1\nHardwareAccel 1\nEnforceDistinctSubnets 1\nAvoidDiskWrites 1\n" | tee $TORRC >/dev/null 2>&1

    if tor --verify-config >/dev/null 2>&1; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Valid Torrc, you can restart Tor${NC}\n"
      chown -R $TOR_USER:$TOR_USER $TORRC
      chown -R $TOR_USER:$TOR_USER /var/lib/tor
      chattr +i $TORRC >/dev/null 2>&1
      exit 0
    else
      echo -e "\n${RED}[${WHITE}X${RED}] Invalid Torrc${NC}\n"
      exit 1
    fi

    shift 4

    ;;

  --update-project)
    mode=11

    if [ $EUID -ne 0 ]; then
      echo -e "\n${RED}[${WHITE}X${RED}] Run as root${NC}\n"
      exit 1
    fi

    cmd=git

    if ! (command -v $cmd >/dev/null 2>&1); then
      echo -e "\n${RED}[${WHITE}X${RED}] Install: ${ORANGE}'$cmd'${NC}\n"
      exit 1
    fi

    sleep 1

    echo -e "\n${BLUE}[${ORANGE}warn${BLUE}]${GREEN} Updating Archnon ...${NC}"

    if git clone "$REPO_CLEAR" && cd $REPO_DIR && chmod +x * && cp * /usr/local/bin && rm -rf $REPO_DIR; then
      echo -e "\n${BLUE}[${LB}OK${BLUE}]${P} Project is up to date \e[94m(\e[93m$ARCHNON_VERSION\e[97m,\e[95m $LAST_UPDATE\e[94m)${NC}\n"
      exit $?
    else
      echo -e "\n${RED}[${WHITE}X${RED}] Couldn't update project${NC}\n"
      exit 1
    fi

    shift 1
 
    ;;

  --help)
    mode=12

    usage
    exit 1

    shift 1

    ;;
  --version)
    mode=13
    version
    exit 1
    shift 1
    ;;
  --* | -* | *)
    mode=6

    echo -e "\n${RED}[${WHITE}X${RED}] Invalid option: ${ORANGE}'$1'${NC}"
    echo -e "\n${RED}[${YELLOW}warn${RED}]${ORANGE} Try: '${LB}$0 ${BLUE}--help${ORANGE}'${NC}\n"
    exit 1

    shift 1

    ;;

  esac
done

if [ -z $mode ]; then
  usage
  exit 1
fi
